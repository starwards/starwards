{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignoreBinaries": [
        // system binary (docker compose v1 syntax in npm scripts)
        "docker-compose"
    ],
    "ignore": [
        // agent workflow scripts, invoked by name at runtime
        ".claude/**",
        // runtime-mounted into containers, not part of the ts build graph
        "docker/**"
    ],
    "ignoreDependencies": [
        // emit helper, required by tsconfig importHelpers
        "tslib",
        // WebSocket implementation colyseus.js requires at runtime in Node (node-red module)
        "ws",
        // git hooks in .husky/
        "husky",
        // jest reporter, referenced by CLI flag in .github/workflows/ci-cd.yml
        "jest-junit"
    ],
    "ignoreUnresolved": [
        // ambient type-only packages resolved via tsconfig typeRoots (custom-typings/),
        // which knip does not follow the way it does compilerOptions.paths
        "mini-signals",
        "pixi__core",
        "pixi__filter-noise"
    ],
    "workspaces": {
        ".": {
            "entry": ["scripts/*.{js,mjs,sh}", ".github/k8s/*.{js,ts}", "*.{js,mjs,ts}"],
            "ignoreDependencies": [
                // custom-typings/golden-layout is an ambient module augmentation; the
                // real dependency lives in modules/browser
                "golden-layout"
            ]
        },
        "modules/node-red": {
            "entry": ["src/*/*.ts", "src/**/index.ts", "rollup.config*.mjs"]
        },
        "modules/server": {
            "entry": ["src/prod.ts"]
        }
    }
}
