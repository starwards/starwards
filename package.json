{
    "name": "starwards",
    "repository": "git@github.com:starwards/starwards.git",
    "author": "amir-arad <greenshade@gmail.com>",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">= 22.11.0",
        "npm": ">= 10.9.0"
    },
    "packageManager": "npm@10.9.2",
    "workspaces": [
        "modules/*"
    ],
    "overrides": {
        "ws@^7": "^7.5.11",
        "picomatch@^4": "^4.0.4",
        "form-data@^4": "^4.0.6"
    },
    "scripts": {
        "predev": "rimraf ./modules/core/cjs/index.js",
        "dev": "concurrently --kill-others -c blue,green,yellow -n core,server,browser \"npm:dev:core\" \"npm:dev:server\" \"npm:dev:browser\"",
        "dev:core": "npm --prefix ./modules/core run build:watch",
        "dev:server": "node scripts/wait-for-core.js",
        "dev:browser": "npm --prefix ./modules/browser run start",
        "dev:zellij": "bash scripts/dev.sh",
        "clean": "rimraf ./modules/browser/dist ./modules/browser/dist ./modules/core/cjs ./modules/server/cjs",
        "postbuild": "node scripts/post-build.js",
        "pretty-quick": "pretty-quick --staged --pattern \"./modules/*/src/**/*.{ts,tsx,json}\"",
        "prettify": "prettier \"./modules/*/src/**/*.{ts,tsx,json}\" -w",
        "build:browser": "npm --prefix ./modules/browser run build",
        "build:core": "npm --prefix ./modules/core run build",
        "build:unity": "npm --prefix ./modules/core run build:unity",
        "build:node-red": "npm --prefix ./modules/node-red run build",
        "build:server": "npm --prefix ./modules/server run build",
        "build": "turbo run build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:docs": "node scripts/lint-docs.mjs",
        "xstate-typegen": "xstate typegen \"./modules/core/src/**/*.ts?(x)\"",
        "knip": "knip",
        "prettier": "prettier -c **/*.{js,ts,jsx,tsx}",
        "test": "jest",
        "snapshots:ci": "docker-compose -f ./modules/e2e/docker-compose.yml up",
        "test:all": "npm run test:format && npm run test:types && npm run test && npm run test:e2e",
        "test:e2e": "playwright test --project=chromium",
        "test:widgets": "playwright test modules/e2e/test/visual/gallery.spec.ts --project=chromium-headed",
        "test:format": "npm run prettier && npm run lint",
        "test:types": "tsc --noEmit --skipLibCheck",
        "depcheck": "depcruise --config .dependency-cruiser.cjs modules",
        "test:coverage:core": "jest --testPathPatterns=modules/core --coverage --coverageDirectory=coverage-core --collectCoverageFrom='modules/core/src/**/*.ts' --coverageThreshold='{\"./modules/core/src/\":{\"lines\":69,\"functions\":58,\"branches\":51,\"statements\":69}}'",
        "start": "npm --cwd ./dist run start",
        "browser": "npm --prefix ./modules/browser run start",
        "node-red": "bash ./scripts/dev-node-red.sh",
        "prepack": "npm run build",
        "pkg": "node scripts/pkg.js",
        "release": "bash ./scripts/release.sh"
    },
    "importSort": {
        ".ts, .tsx": {
            "parser": "typescript",
            "style": "eslint"
        }
    },
    "lint-staged": {
        "./modules/*/{src,test}/**/*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix --no-warn-ignored"
        ],
        "./modules/*/{src,test}/**/*.json": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@colyseus/loadtest": "^0.16.1",
        "@playwright/test": "^1.61.1",
        "@rollup/plugin-sucrase": "^5.1.0",
        "@types/chai": "^5.2.3",
        "@types/d3-selection": "^3.0.11",
        "@types/debug": "4.1.13",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jquery": "^3.5.34",
        "@types/node": "^24.13.2",
        "@types/node-red": "^1.3.5",
        "@types/node-red-node-test-helper": "^0.3.5",
        "@types/pluralize": "^0.0.33",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/sinon": "^17.0.4",
        "@types/supertest": "^7.2.0",
        "@types/webfontloader": "^1.6.38",
        "@typescript-eslint/eslint-plugin": "^8.62.1",
        "@typescript-eslint/parser": "^8.62.1",
        "@xstate/cli": "^0.5.17",
        "chai": "^6.2.2",
        "concurrently": "^10.0.3",
        "copyfiles": "^2.4.1",
        "dependency-cruiser": "^18.0.0",
        "esbuild-loader": "^4.5.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fast-check": "^4.8.0",
        "file-loader": "^6.2.0",
        "globals": "^17.7.0",
        "globby": "^16.2.0",
        "html-webpack-plugin": "^5.6.7",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "knip": "^5.66.2",
        "lint-staged": "^16.4.0",
        "ncp": "^2.0.0",
        "node-red": "^4.1.11",
        "node-red-node-test-helper": "^0.3.6",
        "pkg": "^5.8.1",
        "playwright": "^1.61.1",
        "prettier": "^3.9.4",
        "pretty-quick": "^4.2.2",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "turbo": "^2.10.3",
        "typescript": "^6.0.3",
        "webpack": "^5.108.3",
        "webpack-cli": "^7.1.0",
        "webpack-dev-server": "^5.2.6",
        "webpack-merge": "^6.0.1"
    }
}
