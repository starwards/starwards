{
    "version": "1.30.4",
    "type": "session",
    "content": {
        "type": "root",
        "id": "root",
        "widgets": [
            {
                "type": "panel",
                "id": "reactor_panel",
                "layout": "horizontal",
                "width": "100%",
                "height": "100%",
                "innerPadding": true,
                "widgets": [
                    {
                        "type": "panel",
                        "id": "power_column",
                        "layout": "vertical",
                        "expand": true,
                        "widgets": [
                            {
                                "type": "fader",
                                "id": "reactor_power",
                                "expand": true,
                                "address": "/reactor/power",
                                "preArgs": [],
                                "range": {
                                    "min": 0,
                                    "max": 1
                                }
                            },
                            {
                                "type": "text",
                                "id": "power_label",
                                "height": 40,
                                "value": "POWER"
                            }
                        ]
                    },
                    {
                        "type": "panel",
                        "id": "coolant_column",
                        "layout": "vertical",
                        "expand": true,
                        "widgets": [
                            {
                                "type": "fader",
                                "id": "reactor_coolant",
                                "expand": true,
                                "address": "/reactor/coolantFactor",
                                "preArgs": [],
                                "range": {
                                    "min": 0,
                                    "max": 1
                                }
                            },
                            {
                                "type": "text",
                                "id": "coolant_label",
                                "height": 40,
                                "value": "COOLANT"
                            }
                        ]
                    },
                    {
                        "type": "panel",
                        "id": "energy_column",
                        "layout": "vertical",
                        "expand": true,
                        "widgets": [
                            {
                                "type": "fader",
                                "id": "reactor_energy",
                                "expand": true,
                                "address": "/reactor/energy",
                                "preArgs": [],
                                "range": {
                                    "min": 0,
                                    "max": 1000
                                }
                            },
                            {
                                "type": "text",
                                "id": "energy_label",
                                "height": 40,
                                "value": "ENERGY"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
