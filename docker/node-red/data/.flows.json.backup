[{"id":"tab-osc-bridge","type":"tab","label":"OSC Bridge","disabled":false,"info":"Open Stage Control ↔ Starwards OSC bridge.\nWrite path: tablet widget → UDP → OSC decode → ship-write\nFeedback path: ship-read subscribe → RBE → rate-limit → OSC encode → UDP → tablet"},{"id":"starwards-config-1","type":"starwards-config","z":"tab-osc-bridge","name":"Starwards","url":"http://starwards-server:8080"},{"id":"udp-osc-in","type":"udp in","z":"tab-osc-bridge","name":"OSC from tablets","iface":"","port":"57120","ipv":"udp4","multicast":"false","group":"","datatype":"buffer","x":300,"y":80,"wires":[["osc-decode-in"]]},{"id":"osc-decode-in","type":"osc","z":"tab-osc-bridge","name":"OSC decode","path":"","metadata":false,"x":590,"y":80,"wires":[["route-subscribe-or-write"]]},{"id":"route-subscribe-or-write","type":"switch","z":"tab-osc-bridge","name":"subscribe vs write","property":"topic","propertyType":"msg","rules":[{"t":"eq","v":"/starwards/subscribe","vt":"str"},{"t":"else"}],"checkall":"false","repair":false,"outputs":2,"x":810,"y":80,"wires":[["fn-make-subscribe"],["ship-write-1"]]},{"id":"fn-make-subscribe","type":"function","z":"tab-osc-bridge","name":"make subscribe msg","func":"// OSC custom module sends /starwards/subscribe with one arg: the pointer\n// Transform to { topic: pointer, subscribe: true } for ship-read\nvar ptr = Array.isArray(msg.payload) ? msg.payload[0] : msg.payload;\nif (typeof ptr !== 'string' || !ptr.startsWith('/')) {\n    return null; // drop malformed\n}\nmsg.topic = ptr;\nmsg.subscribe = true;\ndelete msg.payload;\nreturn msg;","outputs":1,"x":1040,"y":180,"wires":[["ship-read-1"]]},{"id":"ship-read-1","type":"ship-read","z":"tab-osc-bridge","name":"ship-read","configNode":"starwards-config-1","shipId":"GVTS","x":990,"y":220,"wires":[["rate-limit-1"]]},{"id":"ship-write-1","type":"ship-write","z":"tab-osc-bridge","name":"ship-write","configNode":"starwards-config-1","shipId":"GVTS","x":770,"y":120,"wires":[]},{"id":"rate-limit-1","type":"delay","z":"tab-osc-bridge","name":"rate limit 25 msg/s","pauseType":"rate","timeout":"5","timeoutUnits":"seconds","rate":"25","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":true,"allowrate":false,"outputs":1,"x":1030,"y":280,"wires":[["osc-encode-out"]]},{"id":"osc-encode-out","type":"osc","z":"tab-osc-bridge","name":"OSC encode","path":"","metadata":false,"x":1010,"y":320,"wires":[["udp-osc-out"]]},{"id":"udp-osc-out","type":"udp out","z":"tab-osc-bridge","name":"OSC to tablets","addr":"open-stage-control","iface":"","port":"57120","outport":"57122","base64":false,"multicast":"false","x":1020,"y":360,"wires":[]},{"id":"udp-subscribe-in","type":"udp in","z":"tab-osc-bridge","name":"Subscribe from O-S-C module","iface":"","port":"57121","ipv":"udp4","multicast":"false","group":"","datatype":"buffer","x":340,"y":180,"wires":[["osc-decode-sub"]]},{"id":"osc-decode-sub","type":"osc","z":"tab-osc-bridge","name":"OSC decode","path":"","metadata":false,"x":590,"y":180,"wires":[["fn-make-subscribe"]]}]