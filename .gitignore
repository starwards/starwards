# node-red credential-store encryption key — never commit it alongside
# flows_cred.json (the pair makes stored credentials plaintext-equivalent).
# node-red regenerates it on first run.
docker/node-red/data/.config.runtime.json

# node-red runtime backups — regenerated on every deploy
docker/node-red/data/*.backup

# build artifact folders
dist
cjs
esm
umd

# IDEs
.idea

# OS-specific
.DS_Store

# Below is a copy of https://github.com/github/gitignore/blob/master/Node.gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/
ngrok.*
assets
test-results
*.tsbuildinfo
.turbo

modules/core/unity-schema
*.cpuprofile
*.heapprofile
.playwright-mcp/*
coverage-core/

# local visual baselines (only linux snapshots from snapshots:ci are committed)
modules/e2e/test/visual/*-snapshots/*-win32.png
