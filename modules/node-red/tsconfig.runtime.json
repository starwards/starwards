{
    "extends": "./tsconfig.json",
    "include": ["src"],
    "compilerOptions": {
        "module": "commonjs",
        "outDir": "dist",
        "experimentalDecorators": true,
        "paths": {
            "@starwards/core": ["../core/cjs"],
            "@starwards/core/internal": ["modules/core/cjs/index.internal"]
        }
    },
    "exclude": ["node_modules", "src/**/*.spec.ts", "src/test-driver.ts", "src/*/*.html"]
}
