{
    "name": "@starwards/ai",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.md",
    "description": "Station brains that play Starwards, and the harness that trains them in the headless game",
    "scripts": {
        "train": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/train.ts",
        "build:cli": "node build-cli.mjs",
        "pretrain:js": "npm run build:cli",
        "train:js": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev ./dist/cli/train.js",
        "decisions": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/decisions.ts",
        "reask": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/reask.ts",
        "read": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/read.ts",
        "bench": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/bench.ts",
        "suite": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev -r ts-node/register/transpile-only ./src/cli/suite.ts",
        "agree": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env.jev --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/agree.ts",
        "eval-queue": "node -r ts-node/register/transpile-only ./src/cli/eval-queue.ts",
        "composite": "node -r ts-node/register/transpile-only ./src/cli/composite.ts",
        "waves": "node --env-file-if-exists=.env --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/waves.ts",
        "search": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/search.ts",
        "compare": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/compare.ts",
        "score:dataset": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/dataset.ts",
        "score": "node -r ts-node/register/transpile-only ./src/scoring/cli.ts",
        "score:engineer": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/engineer-validate.ts",
        "score:helms-labels": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/relabel-helms.ts",
        "score:helms": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/helms-validate.ts",
        "score:weapons-runs": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/weapons-runs.ts",
        "score:weapons": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/scoring/weapons-validate.ts",
        "heatmap:dataset": "node --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/heatmap/dataset.ts",
        "heatmap": "node -r ts-node/register/transpile-only ./src/heatmap/cli.ts",
        "branch": "node --env-file-if-exists=.env --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/branch.ts",
        "prebranch:js": "npm run build:cli",
        "branch:js": "node --env-file-if-exists=.env --max-old-space-size=8192 ./dist/cli/branch.js",
        "sweep": "node --env-file-if-exists=.env --max-old-space-size=8192 -r ts-node/register/transpile-only ./src/cli/sweep.ts"
    },
    "dependencies": {
        "@starwards/bots": "0.5.1",
        "@starwards/core": "0.5.1",
        "@starwards/server": "0.0.0",
        "zod": "4.1.12"
    }
}
