{
    "name": "@starwards/core",
    "description": "a space and starship simulator designed specifically for LARPs",
    "keywords": [
        "sbs",
        "larp",
        "game",
        "simulator",
        "starship",
        "space",
        "colyseus"
    ],
    "version": "0.5.1",
    "main": "cjs/index.public.js",
    "types": "cjs/index.public.d.ts",
    "exports": {
        ".": {
            "types": "./cjs/index.public.d.ts",
            "default": "./cjs/index.public.js"
        },
        "./internal": {
            "types": "./cjs/index.internal.d.ts",
            "default": "./cjs/index.internal.js"
        },
        "./package.json": "./package.json"
    },
    "repository": "git@github.com:starwards/starwards.git",
    "author": "amir-arad <greenshade@gmail.com>",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "engines": {
        "node": ">= 18"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "files": [
        "cjs",
        "src"
    ],
    "scripts": {
        "clean": "rimraf ./cjs",
        "postbuild": "npm pack --quiet",
        "prebuild": "npm run clean",
        "build": "tsup-node",
        "build:unity": "schema-codegen src/space/space-state.ts --output ./unity-schema/ --decorator gameField --csharp",
        "build:watch": "tsup-node --watch"
    },
    "dependencies": {
        "@colyseus/schema": "^3.0.76",
        "colyseus-events": "^4.1.0",
        "colyseus.js": "^0.16.22",
        "debug": "4.4.3",
        "detect-collisions": "^10.10.2025",
        "eventemitter2": "^6.4.9",
        "eventemitter3": "^5.0.4",
        "normal-distribution": "^1.1.1",
        "reflect-metadata": "^0.2.2",
        "ts-essentials": "^10.2.1",
        "tslib": "^2.8.1",
        "ws": "^8.21.0",
        "xstate": "^5.32.4"
    }
}
