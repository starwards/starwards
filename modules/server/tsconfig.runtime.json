{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "outDir": "cjs",
        "experimentalDecorators": true,
        "paths": {
            "@starwards/core": ["../core/cjs"],
            "@starwards/core/internal": ["modules/core/cjs/index.internal"]
        }
