{
    "name": "@starwards/server",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.md",
    "main": "cjs/index.js",
    "files": [
        "cjs"
    ],
    "scripts": {
        "clean": "rimraf ./cjs",
        "prebuild": "npm run clean",
        "build": "tsc -p ./tsconfig.runtime.json",
        "build_watch": "tsc -p ./tsconfig.runtime.json --watch",
        "start": "node -r ts-node/register/transpile-only ./src/dev.ts",
        "loadtest": "colyseus-loadtest loadtest/bot.ts --room space --endpoint ws://localhost:8080",
        "test": "jest",
        "training": "node -r ts-node/register/transpile-only ./src/test/training/run-training.ts",
        "analyze": "node -r ts-node/register/transpile-only ./src/test/training/analysis/cli.ts"
    },
    "dependencies": {
        "@colyseus/core": "^0.18.19",
        "@colyseus/monitor": "^0.18.6",
        "@colyseus/schema": "^5.0.40",
        "@colyseus/ws-transport": "^0.18.4",
        "@starwards/bots": "0.5.1",
        "@starwards/core": "0.5.1",
        "express": "^5.2.1",
        "express-async-handler": "^1.2.0",
        "express-basic-auth": "^1.2.1",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "duckdb": "^1.4.4",
        "eventemitter3": "^5.0.4",
        "@colyseus/sdk": "^0.18.5"
    }
}
